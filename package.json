{
  "name": "code-to-flowchart",
  "private": true,
  "scripts": {
    "test": "node --test tests/core.test.cjs tests/flowchart.test.cjs tests/code-colors.test.cjs tests/library.test.cjs tests/diagram-settings.test.cjs tests/sitemap.test.cjs tests/asset-cache.test.cjs tests/diagram-export.test.cjs",
    "test:ui": "node --test tests/ui.test.cjs tests/library-ui.test.cjs tests/seo.test.cjs tests/settings-ui.test.cjs tests/search-guides.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-flowchart-library \"node --test tests/firestore.test.cjs\"",
    "build:guides": "node scripts/build-guides.cjs",
    "check:guides": "node scripts/build-guides.cjs --check",
    "check:sitemap": "node scripts/check-sitemap.cjs",
    "check:sitemap:live": "node scripts/check-sitemap.cjs --live",
    "version:assets": "node scripts/version-assets.cjs",
    "check:assets": "node scripts/version-assets.cjs --check",
    "build:parser": "node scripts/build-parser.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@lezer/cpp": "^1.1.6",
    "@lezer/generator": "^1.8.1",
    "@lezer/java": "^1.1.5",
    "@lezer/python": "^1.1.19",
    "esbuild": "^0.28.2",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "playwright": "1.56.1"
  }
}
